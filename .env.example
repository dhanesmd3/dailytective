# Salin jadi .env (sudah di-.gitignore). Jangan pernah commit .env.

# Rahasia untuk menandatangani token pemain anonim. Wajib di luar `npm run dev`, minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DT_SECRET=

# Penyimpanan sesi di Redis (Upstash). Wajib di Vercel; terisi otomatis kalau database Upstash
# disambungkan lewat tab Storage di dashboard Vercel. Kosongkan untuk lokal (pakai .data/sesi.json).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Alamat utama situs untuk SEO (canonical, sitemap, gambar pratinjau link). Isi dengan domainmu
# supaya alamat lain seperti *.vercel.app tidak dianggap konten ganda oleh Google.
# DT_SITUS=https://dailytective.dhanesworo.site

# Mode pratinjau: izinkan ?tanggal=YYYY-MM-DD dan reset sesi. Otomatis aktif saat `npm run dev`.
# JANGAN aktifkan di produksi: pemain bisa membuka kasus yang belum terbit.
# DT_PRATINJAU=1

# Paksa "hari ini" ke tanggal tertentu (berguna untuk playtest di staging).
# DT_TANGGAL=2026-11-02
